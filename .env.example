# Configuração do Supabase (Voto Consciente)
# Obtenha estas credenciais no painel do Supabase em Project Settings > API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...sua-chave-anon-publica...

# Usado exclusivamente em scripts de seed e migração em linha de comando (nunca expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...sua-chave-service-role...
